.DS_Store

# Generated deploy artifacts (rebuild with ./build-site.sh)
site/
site-deploy.zip
site.zip

# Local Netlify folder
.netlify

# Local secrets — NEVER commit (Zoom/Stripe credentials for local testing)
.env
.env.*

